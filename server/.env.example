# ---- Core ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/brandshield
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRY=7d
CLIENT_ORIGIN=http://localhost:5173

# ---- AI gateway (leave AI_PROVIDER=none for deterministic rule-only mode) ----
# none | openai
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# ---- Confidential Mode / privacy ----
CONFIDENTIAL_MODE=false
AI_LOG_RETENTION_DAYS=30

# ---- Upload + URL fetch safety ----
UPLOAD_MAX_BYTES=5242880
URL_FETCH_MAX_BYTES=2097152
URL_FETCH_TIMEOUT_MS=8000
ALLOW_PRIVATE_URL_TARGETS=false

# ---- Seeding ----
SEED_DEMO_DATA=true
